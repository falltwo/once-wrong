# API-specific configuration example. Prefer the repository root .env.example
# for combined API and AI settings. uvicorn does not automatically read this file.
# From repo root: python -m uvicorn once_wrong.main:app --env-file backend/.env
# PowerShell: $env:ONCE_WRONG_DB = "C:\path\to\once_wrong.sqlite3"
# POSIX: export ONCE_WRONG_DB=/path/to/once_wrong.sqlite3

# Omit to use backend/data/once_wrong.sqlite3, anchored to the backend package.
# ONCE_WRONG_DB=/absolute/path/to/once_wrong.sqlite3

# Inserts the synthetic reserve-202609 demo only when it does not exist.
ONCE_WRONG_SEED_DEMO=true

# Comma-separated exact browser origins. No wildcard origin by default.
ONCE_WRONG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relative paths below are anchored to the repository root, regardless of cwd.
ONCE_WRONG_KB=data/kb
ONCE_WRONG_RULE_MEMORY=config/rule_notes.jsonl
ONCE_WRONG_EVALUATION=docs/evaluation/2026-10-28-gemini-3.5-flash.json

# Select a provider explicitly, or keep the AI branch's auto selection:
# with an OpenRouter key use OpenRouter; otherwise use Gemini.
# ONCE_WRONG_PROVIDER=openrouter
# Gemini settings are used when Gemini is selected.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
ONCE_WRONG_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_REASONING=low
# OPENROUTER_TEMPERATURE=0.2
# Optional positive output-token cap; the current demo evaluation uses 2048.
# Leave unset to retain provider defaults; choose an appropriate cap for each model.
# OPENROUTER_MAX_TOKENS=2048

# Missing credentials leave the API available with full fallback suggestions.
