# Configuration examples only. uvicorn does not automatically read this file.
# PowerShell: $env:ONCE_WRONG_DB = "C:\path\to\once_wrong.sqlite3"
# POSIX: export ONCE_WRONG_DB=/path/to/once_wrong.sqlite3

# Omit to use backend/data/once_wrong.sqlite3, anchored to the backend package.
# ONCE_WRONG_DB=/absolute/path/to/once_wrong.sqlite3

# Inserts the synthetic reserve-202609 demo only when it does not exist.
ONCE_WRONG_SEED_DEMO=true

# Comma-separated exact browser origins. No wildcard origin by default.
ONCE_WRONG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
