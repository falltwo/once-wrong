# 在 repo 根目錄複製成 .env 後填入（.env 不會被提交）。
# 啟動範例：python -m uvicorn once_wrong.main:app --env-file .env

# ---- API ----
# 省略 DB 時使用 backend/data/once_wrong.sqlite3；自訂建議用絕對路徑。
# ONCE_WRONG_DB=/absolute/path/to/once_wrong.sqlite3
ONCE_WRONG_SEED_DEMO=true
ONCE_WRONG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 這三個相對路徑一律以 repo 根目錄解析。
ONCE_WRONG_KB=data/kb
ONCE_WRONG_RULE_MEMORY=config/rule_notes.jsonl
ONCE_WRONG_EVALUATION=docs/evaluation/2026-10-28-gemini-3.5-flash.json

# 團隊使用 OpenRouter；明確指定，缺少金鑰時仍維持此供應商並回固定說明。
ONCE_WRONG_PROVIDER=openrouter

# ---- OpenRouter ----
OPENROUTER_API_KEY=
# 模型 id，見 https://openrouter.ai/models（要支援 structured outputs）
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# 思考強度 low／medium／high，不設就用模型預設；思考 token 按輸出計費
# OPENROUTER_REASONING=low
# 不設就不送；推理模型（例如 openai/gpt-6-luna）不接受 temperature
# OPENROUTER_TEMPERATURE=0.2

# ---- Gemini（選用，改用 Gemini 時才需設定）----
GOOGLE_API_KEY=
# 用 Vertex AI（Google Cloud 專案的 API 金鑰）時設為 true；AI Studio 的金鑰保持 false
GOOGLE_GENAI_USE_VERTEXAI=false
# 模型名稱，可換成其他 Gemini 模型
ONCE_WRONG_MODEL=gemini-3.5-flash

# OpenRouter 金鑰留空時仍可上傳／檢核；建議端點回固定說明，不會呼叫模型。
