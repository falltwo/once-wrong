# 複製成 .env 後填入（.env 已在 .gitignore，不會被提交）

# 用哪一家：gemini 或 openrouter。不設時，有 OPENROUTER_API_KEY 就用 openrouter，否則 gemini
# ONCE_WRONG_PROVIDER=openrouter

# ---- OpenRouter ----
OPENROUTER_API_KEY=
# 模型 id，見 https://openrouter.ai/models（要支援 structured outputs）
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# 思考強度 low／medium／high，不設就用模型預設；思考 token 按輸出計費
# OPENROUTER_REASONING=low
# 不設就不送；推理模型（例如 openai/gpt-6-luna）不接受 temperature
# OPENROUTER_TEMPERATURE=0.2

# ---- Gemini ----
GOOGLE_API_KEY=
# 用 Vertex AI（Google Cloud 專案的 API 金鑰）時設為 true；AI Studio 的金鑰保持 false
GOOGLE_GENAI_USE_VERTEXAI=false
# 模型名稱，可換成其他 Gemini 模型
ONCE_WRONG_MODEL=gemini-3.5-flash
